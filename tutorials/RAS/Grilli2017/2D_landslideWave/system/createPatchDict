FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

patches
(
    {
        name    plane;  // Name of the new patch
        patchInfo
        {
            type    wall;  // Patch type, you can modify this to patch, empty, etc.
        }
        constructFrom    patches;
        patches
        (
            oldInternalFaces  // The patch you want to rename (i.e., the default created patch)
        );
    }
);


pointSync   true; 
